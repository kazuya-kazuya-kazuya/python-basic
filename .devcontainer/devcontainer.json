{
    "name": "Python Basic",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/python-basic",
    "shutdownAction": "stopCompose",
    // 👇 ここに options を追加して、Docker Compose経由で起動するコンテナにDNS 8.8.8.8 を強制指定します
    "options": "--dns=8.8.8.8",
    "forwardPorts": [
        8888
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-toolsai.jupyter",
                "eamodio.gitlens"
            ]
        }
    }
}